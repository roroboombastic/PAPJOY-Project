# ===== PAPJOY Environment Variables =====
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ===== Razorpay (Required for Card/UPI payments) =====
# Get keys from: https://dashboard.razorpay.com → Settings → API Keys
# Example: rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=
# Example: your_razorpay_secret
RAZORPAY_KEY_SECRET=

# ===== MongoDB =====
# Production: Use MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/papjoy?retryWrites=true&w=majority
# Local development (optional fallback)
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/papjoy
# Set to 'false' in production to prevent fallback to local DB
MONGO_FALLBACK_TO_LOCAL=false

# ===== Server =====
# Production: https://your-app.onrender.com
APP_URL=http://localhost:3000
# Production: https://your-frontend.vercel.app
# Frontend origin used in password-reset email links (NOT the API server)
FRONTEND_URL=http://localhost:5500
# Production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
FORCE_HTTPS=false
HTTPS_ENABLED=false

# ===== Google OAuth (Optional) =====
GOOGLE_CLIENT_ID=your_google_client_id_here

# ===== JWT (Required) =====
# Generate a long random string for production
JWT_SECRET=your_jwt_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_at_least_32_characters_long
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# ===== Email (SMTP for notifications) =====
# Gmail example: smtp.gmail.com | 587 | your.email@gmail.com | app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=papp.joyy@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=PAP-JOY
SMTP_FROM_ADDRESS=papp.joyy@gmail.com

# ===== Admin =====
# Comma-separated email addresses for admin access
ADMIN_EMAILS=papp.joyy@gmail.com

# ===== SSL (Optional - for HTTPS) =====
SSL_KEY_PATH=
SSL_CERT_PATH=
SSL_CA_PATH=
